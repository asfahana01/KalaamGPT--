FLASK_SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=sqlite:///kalamgpt.db

# Optional talking-avatar video generation (D-ID)
# Use an image URL you have permission to send to D-ID; it must be publicly reachable over HTTPS.
DID_API_KEY=API_USER:API_PASSWORD
DID_SOURCE_URL=https://your-authorized-image-host.example/avatar-kalam.jpg
# Optional: pre-generated, silent looping D-ID avatar video on an HTTPS host.
DID_IDLE_VIDEO_URL=

# SMTP Email Configuration (for OTP Email Verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=KalaamGPT <noreply@kalaamgpt.com>
